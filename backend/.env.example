# Copy this file to .env and fill in real values before running in production.

# Security
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Development (default): SQLite
DATABASE_URL=sqlite:///../database/carebot.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/carebot

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional: real LLM integration for the chatbot (falls back to the
# built-in rule-based NLP engine if not set)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: hospital locator - real geocoding provider
# GOOGLE_MAPS_API_KEY=
